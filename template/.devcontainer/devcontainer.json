{
  // Dev container for a forge product: .NET 10 + Node LTS, nothing else.
  //
  // SANDBOX RULE (forge ADR 0013 + 0016): this is the *fallback* boundary for host
  // classes where Docker Sandboxes is not available (see SANDBOX.md). It is hardened:
  //   - NO cloud tooling (no az / terraform / kubectl / cloud-credential features).
  //   - Deny-by-default egress, with an explicit allowlist (init-firewall.sh).
  //   - A startup check that FAILS LOUDLY if cloud credentials are detectable inside
  //     (verify-no-cloud-creds.sh).
  //   - FORGE_SANDBOX=devcontainer so the plugin's guard hook recognises this as an
  //     approved boundary.
  //
  // NEVER MOUNTED / NEVER PASSED IN (do not "helpfully" add any of these):
  //   ~/.azure  ~/.aws  ~/.kube  ~/.config/gcloud  ~/.docker/config.json
  //   env: AWS_*  AZURE_*  ARM_*  GOOGLE_APPLICATION_CREDENTIALS  KUBECONFIG
  //   No cloud CLIs, no kubeconfigs, no service-account keys. The agent gets the
  //   repo + a scoped GitHub PAT (GH_TOKEN) + the local toolchain only. Infra
  //   changes are code in PRs that pipelines apply after a human merge.
  "name": "forge-product",
  "image": "mcr.microsoft.com/devcontainers/dotnet:1-10.0",
  "features": {
    // Node LTS for the web/ app. No cloud features (see SANDBOX RULE above).
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },
  // NET_ADMIN/NET_RAW let init-firewall.sh install the egress allowlist (iptables).
  "runArgs": [
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW"
  ],
  "containerEnv": {
    // Marks this as an approved forge boundary for the SessionStart guard hook.
    "FORGE_SANDBOX": "devcontainer"
  },
  "remoteEnv": {
    // Scoped, per-repo fine-grained GitHub PAT — exported in the HOST shell before
    // launch (see SANDBOX.md "GitHub credentials"). Never commit it. Empty if unset.
    "GH_TOKEN": "${localEnv:GH_TOKEN}"
  },
  "forwardPorts": [5283, 5173, 5432],
  // Once, at create: install web deps (needs network; runs before the firewall locks down).
  "postCreateCommand": "cd web && npm install",
  // Every start: (re)apply the egress allowlist, then fail loudly if any cloud
  // credential is detectable inside the container.
  "postStartCommand": "sudo bash .devcontainer/init-firewall.sh && bash .devcontainer/verify-no-cloud-creds.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
