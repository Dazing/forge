      "timeoutMs": 120000,
      "testResults": false
    },
    {
      "id": "baseline-behavior",
      "executable": "/usr/bin/dotnet",
      "args": ["run", "--project", "tests/Inventory.Tests/Inventory.Tests.csproj"],
      "timeoutMs": 120000,
      "testResults": false
    }
  ],
