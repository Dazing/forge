{
  "schemaVersion": 1,
  "protectedRunnerConfig": "../proof/harness/trusted_acceptance.py",
  "acceptance": {
    "candidateDirectory": ".factory/acceptance-candidate",
    "manifestFile": "manifest.json",
    "integrationDirectory": "tests/Factory.Acceptance",
    "command": {
      "id": "authoritative-acceptance",
      "executable": "/usr/bin/python3",
      "args": ["{runnerConfig}", "--workspace", "{workspace}", "--suite", "{suite}"],
      "timeoutMs": 120000,
      "testResults": true,
      "expectedFailureExitCode": 1
    }
  },
  "baselineChecks": [
    {
      "id": "baseline-build",
      "executable": "/usr/bin/dotnet",
