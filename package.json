{
  "name": "local-software-factory-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "check": "npm run typecheck && npm run check:dependencies && npm test",
    "check:dependencies": "tsx tools/check-dependencies.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "factory": "tsx apps/factory-cli/src/main.ts"
  },
  "devDependencies": {
    "@types/node": "25.0.10",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@ai-hero/sandcastle": "0.12.0",
    "zod": "4.6.5"
  }
}
