{
  "name": "local-sandcastle-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "scripts": {
    "sandcastle": "tsx factory/main.ts",
    "prepare:scenario": "tsx proof/harness/materialize-fixture.ts",
    "evaluate": "tsx proof/harness/evaluate.ts",
    "test": "tsx --test \"factory/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check:architecture": "dependency-cruiser --config .dependency-cruiser.cjs factory",
    "verify": "npm run typecheck && npm test && npm run check:architecture"
  },
  "devDependencies": {
    "@types/node": "25.0.10",
    "dependency-cruiser": "18.5.0",
    "tsx": "4.21.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@ai-hero/sandcastle": "0.12.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  }
}
