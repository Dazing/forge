#!/usr/bin/env python3
"""Read a single locked value: lock-get --lock <path> <entry> <field>.

First validates the entire lock through verify-lock (single source of truth),
then prints one field of one entry so callers never hand-parse the JSON.

Fields: reference_or_url, sha256, platform.
Exits non-zero if validation fails, the entry is missing, or the field is empty.
"""

from __future__ import annotations

import json
import subprocess
import sys
from pathlib import Path

FIELDS = {"reference_or_url", "sha256", "platform", "note"}


def main(argv: list[str]) -> int:
    if len(argv) != 4 or argv[0] != "--lock":
        print("usage: lock-get --lock <path> <entry> <field>", file=sys.stderr)
        return 2
    lock_path, name, field = argv[1], argv[2], argv[3]

    # Reuse verify-lock as the authority so a mismatched/placeholder lock fails here too.
    here = Path(__file__).resolve().parent
    rc = subprocess.run(
        [sys.executable, str(here / "verify-lock"), "--lock", lock_path],
        capture_output=True,
        text=True,
    )
    if rc.returncode != 0:
        sys.stderr.write(rc.stderr)
        return rc.returncode

    if field not in FIELDS:
        print(f"lock-get: unknown field {field!r} (allowed: {sorted(FIELDS)})", file=sys.stderr)
        return 2

    try:
        lock = json.loads(Path(lock_path).read_text(encoding="utf-8"))
        entries = {e["name"]: e for e in lock["entries"]}
        if name not in entries:
            print(f"lock-get: no entry named {name!r}", file=sys.stderr)
            return 1
        value = str(entries[name].get(field, "")).strip()
    except (OSError, ValueError, KeyError) as exc:
        print(f"lock-get: cannot read lock: {exc}", file=sys.stderr)
        return 1

    # `platform` and `reference_or_url` must never be empty; `note`/`sha256` may be blank.
    if field in ("reference_or_url", "platform") and not value:
        print(f"lock-get: entry {name!r} has empty field {field!r}", file=sys.stderr)
        return 1

    print(value)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
